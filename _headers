# =========================================================================
# Cabecalhos HTTP — lido automaticamente pelo Cloudflare Pages.
# Arquivo de texto puro, sem build. Regras mais especificas vencem.
# =========================================================================

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# HTML sempre revalidado: voce edita o texto e ve no ar na hora.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/404.html
  Cache-Control: public, max-age=0, must-revalidate

# CSS, JS e imagens: 1 dia de cache. Se trocar a logo e quiser ver na hora,
# recarregue com Ctrl+Shift+R ou renomeie o arquivo.
/assets/*
  Cache-Control: public, max-age=86400

# A fonte nunca muda de conteudo (o nome do arquivo carrega a versao), entao
# pode ficar um ano em cache. immutable evita ate a revalidacao.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# -------------------------------------------------------------------------
# Sobre o 'unsafe-inline' no CSP acima: a pagina tem dois blocos inline que
# nao da para externalizar — a linha que marca o <html> como "com JS" (precisa
# rodar antes da primeira pintura) e o JSON-LD do Google. Como o site e
# estatico, nao le parametro de URL e nao tem formulario, nao existe entrada
# de usuario para virar XSS. O resto do CSP continua fechado: 'self' em tudo,
# nenhum dominio externo carrega nada.
# -------------------------------------------------------------------------
